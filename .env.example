# ============================================================================
# WebDep — Main Admin Login ID & Configuration (.env.example)
# ============================================================================
# Copy this file to .env and customize your settings.
# Leave ADMIN_PASSWORD blank on first startup to generate a random bootstrap
# password automatically (logged once at startup and saved to .env).
# ============================================================================

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_RESET_2FA=false

HOST=0.0.0.0
PORT=4600
DATA_DIR=./data
SESSION_TTL_S=604800
SESSION_IDLE_TIMEOUT_S=1800
FORCE_SECURE_COOKIES=false

# Set to false to stop WebDep from editing the host firewall (UFW / iptables), including
# the WireGuard mesh rules. Recommended when the panel sits behind an existing reverse proxy
# or shares the host with other services.
WEBDEP_MANAGE_FIREWALL=true

# Linux: apps run through a small log relay so they keep running, with their logs, while the
# panel restarts or updates. Set to 0 to start them without it (they then restart with the panel).
# WEBDEP_LOG_RELAY=1
